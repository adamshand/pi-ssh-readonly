{
  "name": "pi-ssh-readonly",
  "version": "0.2.0",
  "description": "Stateless, target-explicit read-only SSH inspection tools for pi.",
  "keywords": [
    "pi-package",
    "pi",
    "ssh",
    "readonly"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "CONTEXT.md",
    "docs/adr"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "pi --no-extensions -e ./index.ts --help | grep -q -- '--ssh-ro'",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "typebox": "^1.3.10"
  },
  "overrides": {
    "minimatch": {
      "brace-expansion": "5.0.9"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.10",
    "typescript": "^5.9.3"
  }
}
