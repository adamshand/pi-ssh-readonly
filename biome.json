{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"files": {
		"includes": ["index.ts", "src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
	},
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"rules": {
			"preset": "none",
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 15 }
				}
			}
		}
	}
}
